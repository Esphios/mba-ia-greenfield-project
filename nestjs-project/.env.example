# Application
NODE_ENV=development
PORT=3000
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Video storage (private S3-compatible bucket)
S3_BACKEND=minio
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=streamtube-videos
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
S3_ALLOWED_ORIGINS=http://localhost:3000
S3_CONNECT_TIMEOUT_MS=5000
S3_CONTROL_TIMEOUT_MS=30000
S3_COMPLETE_TIMEOUT_MS=120000

# Video queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
VIDEO_QUEUE_PREFIX=streamtube

# Video limits
VIDEO_MAX_BYTES=10000000000
VIDEO_PART_BYTES=67108864
VIDEO_UPLOAD_TTL_SECONDS=86400
VIDEO_URL_TTL_SECONDS=900
VIDEO_WORKER_CONCURRENCY=1
VIDEO_WORK_DIR=/work/videos
